---
import ReaderSettings from "./ReaderSettings.astro";

interface Props {
  hasChapters?: boolean;
  solid?: boolean;
}
const { hasChapters = true, solid = false } = Astro.props;
---

<header class="reader-header" data-reader-header data-solid={solid ? "true" : "false"}>
  <a class="reader-brand" href="/" aria-label="Data Impostor home">
    <span>Data Impostor</span>
  </a>

  {
    hasChapters && (
      <button
        class="reader-contents"
        data-contents-toggle
        type="button"
        aria-expanded="false"
        aria-controls="reader-contents-sheet"
        aria-label="Contents"
      >
        <span class="contents-static">Contents</span>
        <span class="contents-label" data-chapter-label>Contents</span>
      </button>
    )
  }

  <div class="reader-tools">
    <button class="reader-listen" data-listen-toggle type="button" aria-pressed="false" aria-label="Listen">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 14v-2a8 8 0 0 1 16 0v2"></path>
        <rect x="2" y="14" width="4" height="7" rx="2"></rect>
        <rect x="18" y="14" width="4" height="7" rx="2"></rect>
      </svg>
      <span class="listen-label" data-listen-label>Listen</span>
    </button>

    <ReaderSettings />

    <details class="reader-menu">
      <summary aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>
      <nav class="reader-menu-panel" aria-label="Site">
        <a href="/blog">Blog</a>
        <a href="/reads">Reads</a>
        <a href="/mastodon">Mastodon</a>
        <a href="/projects">Projects</a>
        <a href="/talks">Talks</a>
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </details>
  </div>

  <div class="reader-progress"><i data-progress></i></div>
</header>

<style>
  .reader-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 22px;
    color: #fff;
    background: transparent;
    border-bottom: 1px solid transparent;
    --bar-line: rgba(255, 255, 255, 0.35);
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .reader-header[data-solid="true"] {
    position: relative;
    color: var(--ink);
    background: var(--bg);
    border-bottom-color: var(--line);
    --bar-line: var(--line);
  }
  .reader-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }
  .reader-header[data-solid="true"] .reader-brand { text-shadow: none; }

  .reader-contents {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 auto;
    border: 1px solid var(--bar-line);
    border-radius: 999px;
    background: rgba(10, 12, 16, 0.42);
    color: inherit;
    padding: 6px 12px 6px 9px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    max-width: 42vw;
    cursor: pointer;
  }
  .reader-header[data-solid="true"] .reader-contents { background: transparent; }
  .contents-static { display: none; }
  .contents-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .reader-listen {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--bar-line);
    border-radius: 999px;
    background: rgba(10, 12, 16, 0.42);
    color: inherit;
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    cursor: pointer;
  }
  .reader-header[data-solid="true"] .reader-listen { background: transparent; }
  .reader-header :global(.settings-toggle) {
    border-color: var(--bar-line);
    color: inherit;
    background: rgba(10, 12, 16, 0.42);
  }
  .reader-header[data-solid="true"] :global(.settings-toggle) { background: transparent; }
  .reader-header :global(.settings-toggle:hover) { color: inherit; border-color: var(--bar-line); }
  .reader-listen[aria-pressed="true"] {
    background: var(--accent) !important;
    border-color: var(--accent) !important;
    color: #fff !important;
  }

  .reader-menu { position: relative; }
  .reader-menu summary {
    display: grid;
    place-items: center;
    width: 34px;
    height: 30px;
    border: 1px solid var(--bar-line);
    border-radius: 999px;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }
  .reader-menu summary::-webkit-details-marker { display: none; }
  .reader-header[data-solid="true"] .reader-menu summary { background: transparent; }
  .reader-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: 190px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--box-shadow);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .reader-menu-panel a {
    display: block;
    padding: 9px 10px;
    border-radius: 7px;
    color: var(--ink);
    text-decoration: none;
    font-size: 13px;
  }
  .reader-menu-panel a:hover { background: var(--code-bg); color: var(--accent); }

  .reader-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
  }
  .reader-progress i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }

  @media (max-width: 720px) {
    .reader-header { padding: 0 12px; gap: 8px; }
    .reader-brand span { display: inline; font-size: 12px; }
    .contents-static { display: inline; }
    .contents-label { display: none; }
    .reader-contents { padding: 6px 9px; }
    .listen-label { display: none; }
    .reader-listen { padding: 6px 8px; }
    .reader-tools { gap: 6px; }
  }
</style>
