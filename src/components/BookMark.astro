---
interface Props {
  class?: string;
}
---

<svg
  class:list={["book-mark", Astro.props.class]}
  viewBox="0 0 34 26"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path class="page page-left" d="M17 6.2C12.4 3.4 7.2 3.1 2.2 5.2v16.3c5-2.1 10.2-1.8 14.8 1V6.2Z" />
  <path class="page page-right" d="M17 6.2c4.6-2.8 9.8-3.1 14.8-1v16.3c-5-2.1-10.2-1.8-14.8 1V6.2Z" />
  <path class="spine" d="M17 6.2v16.3" />
</svg>

<style>
  .book-mark {
    width: 23px;
    height: 18px;
    display: inline-block;
    flex: 0 0 auto;
    overflow: visible;
    color: currentColor;
  }
  .page {
    fill: currentColor;
    opacity: 0.16;
    transition: transform 260ms ease, opacity 260ms ease;
    transform-box: fill-box;
  }
  .page-left { transform-origin: right center; }
  .page-right { transform-origin: left center; }
  .spine {
    stroke: currentColor;
    stroke-width: 1.3;
    opacity: 0.55;
  }
  :global(html[data-book-intro="full"]) .page-left {
    animation: book-open-left 1150ms cubic-bezier(0.22, 0.8, 0.2, 1) both;
  }
  :global(html[data-book-intro="full"]) .page-right {
    animation: book-open-right 1150ms cubic-bezier(0.22, 0.8, 0.2, 1) both;
  }
  :global(html[data-book-intro="subtle"]) .book-mark {
    animation: book-settle 420ms ease both;
  }
  a:hover .page-left { transform: rotate(-5deg) translateY(-1px); opacity: 0.26; }
  a:hover .page-right { transform: rotate(5deg) translateY(-1px); opacity: 0.26; }

  @keyframes book-open-left {
    0% { transform: rotate(0deg) scaleX(1); opacity: 0.16; }
    35% { transform: rotate(-9deg) scaleX(0.9); opacity: 0.3; }
    100% { transform: rotate(0deg) scaleX(1); opacity: 0.16; }
  }
  @keyframes book-open-right {
    0% { transform: rotate(0deg) scaleX(1); opacity: 0.16; }
    35% { transform: rotate(9deg) scaleX(0.9); opacity: 0.3; }
    100% { transform: rotate(0deg) scaleX(1); opacity: 0.16; }
  }
  @keyframes book-settle {
    from { opacity: 0.4; transform: translateY(1px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .page { animation: none !important; transition: none !important; }
  }
</style>
