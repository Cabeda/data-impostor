---
import { MastodonClient } from '../lib/mastodon';

interface Props {
  mastodonUrl: string;
  buildTime?: Date;
}

const { mastodonUrl, buildTime = new Date() } = Astro.props;

const client = new MastodonClient(MastodonClient.instanceFromUrl(mastodonUrl));
const postId = client.extractPostIdFromUrl(mastodonUrl);

let replies: any[] = [];
if (postId) {
  try {
    replies = await client.fetchPostReplies(postId);
  } catch (error) {
    console.error('Failed to fetch replies:', error);
  }
}
---

<div class="mastodon-comments" data-post-id={postId} data-instance={new URL(mastodonUrl).host} data-build-time={buildTime.toISOString()}>
  <div class="comments-list">
    {replies.length === 0 ? (
      <p class="no-comments">No comments yet. <a href={mastodonUrl} target="_blank" rel="noopener">Join the conversation on Mastodon</a></p>
    ) : (
      replies.map(reply => (
        <div class="comment" data-id={reply.id}>
          <div class="comment-header">
            <img src={reply.account.avatar} alt={reply.account.display_name} class="avatar" />
            <div class="comment-meta">
              <strong>{reply.account.display_name}</strong>
              <span class="username">@{reply.account.username}</span>
              <time datetime={reply.created_at}>{new Date(reply.created_at).toLocaleDateString()}</time>
            </div>
          </div>
          <div class="comment-content" set:html={reply.content} />
        </div>
      ))
    )}
  </div>
  <p class="view-on-mastodon">
    <a href={mastodonUrl} target="_blank" rel="noopener">View on Mastodon →</a>
  </p>
</div>

<script>
  const REFRESH_THRESHOLD = 24 * 60 * 60 * 1000; // 24 hours
  const w = window as unknown as { __diMastodonComments?: boolean };

  function refreshMastodonComments() {
    const container = document.querySelector('.mastodon-comments');
    if (!container) return;

    const postId = container.getAttribute('data-post-id');
    const buildTime = new Date(container.getAttribute('data-build-time') || '');
    const now = new Date();

    if (now.getTime() - buildTime.getTime() > REFRESH_THRESHOLD && postId) {
      fetch(`https://${container.getAttribute('data-instance') || 'mastodon.social'}/api/v1/statuses/${postId}/context`)
        .then(res => res.json())
        .then(data => {
          const replies = data.descendants || [];
          const list = container.querySelector('.comments-list');
          if (!list) return;

          if (replies.length === 0) return;

          list.innerHTML = replies.map((reply: any) => `
            <div class="comment" data-id="${reply.id}">
              <div class="comment-header">
                <img src="${reply.account.avatar}" alt="${reply.account.display_name}" class="avatar" />
                <div class="comment-meta">
                  <strong>${reply.account.display_name}</strong>
                  <span class="username">@${reply.account.username}</span>
                  <time datetime="${reply.created_at}">${new Date(reply.created_at).toLocaleDateString()}</time>
                </div>
              </div>
              <div class="comment-content">${reply.content}</div>
            </div>
          `).join('');
        })
        .catch(err => console.error('Failed to refresh comments:', err));
    }
  }

  if (!w.__diMastodonComments) {
    w.__diMastodonComments = true;
    document.addEventListener('astro:page-load', refreshMastodonComments);
  }
  refreshMastodonComments();
</script>

<style>
  .mastodon-comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .comment {
    padding: 1rem;
    background: var(--surface-2);
    border-radius: 8px;
  }

  .comment-header {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .comment-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .comment-meta strong {
    color: var(--ink);
    font-size: 0.9rem;
  }

  .username {
    color: var(--muted);
    font-size: 0.85rem;
  }

  time {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .comment-content {
    margin-left: 52px;
    color: var(--ink);
    line-height: 1.6;
  }

  .no-comments {
    color: var(--muted);
    font-style: italic;
  }

  .view-on-mastodon {
    margin-top: 1.5rem;
    text-align: center;
  }

  .view-on-mastodon a {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .view-on-mastodon a:hover {
    text-decoration: underline;
  }
</style>
