---
// Selected inline discovery layout, progressively enhanced on the client.
import type { CollectionEntry } from "astro:content";
interface Props { posts: CollectionEntry<"blog">[] }
const { posts } = Astro.props;
const records = posts.map((p) => ({ id: p.id, title: p.data.title, description: p.data.description || '', tags: p.data.tags || [], date: p.data.pubDate.toISOString().slice(0, 10) }));
const counts = new Map<string, number>();
records.forEach(p => p.tags.forEach(t => counts.set(t, (counts.get(t) || 0) + 1)));
const tags = [...counts].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const topTopics = 5;
---
<main id="post-discovery" class="archive">
  <header><p class="kicker">Notebook</p><h1>All notes</h1><p class="intro">Notes on data systems, reading, and the rest. Find an idea worth staying with.</p></header>
  <noscript><p>Search needs JavaScript. All notes are listed below.</p></noscript>
  <div class="workspace">
    <div class="results-area">
      <div class="search-controls">
        <label class="search-label" for="discovery-query">Search the notebook</label>
        <input id="discovery-query" type="search" disabled placeholder="Search notes…" />
        <div class="discovery-options">
          <div class="topics" id="discovery-topics" aria-label="Filter by topic">
            {tags.map(([tag,count], index) => <button disabled data-tag={tag} data-extra={index >= topTopics ? '' : undefined} hidden={index >= topTopics} aria-pressed="false">{tag} <small>{count}</small></button>)}
            {tags.length > topTopics && <button id="discovery-more" class="text-control" aria-expanded="false" aria-controls="discovery-topics">More topics</button>}
          </div>
          <details class="advanced"><summary>Advanced search</summary><div class="scope"><label for="discovery-scope">Search in</label><select id="discovery-scope" disabled><option value="all">Everything</option><option value="title">Titles</option><option value="tags">Tags</option><option value="body">Article content</option></select></div></details>
        </div>
        <div class="active-filters" hidden><span id="discovery-active"></span><button id="discovery-reset" class="text-control">Clear filters</button></div>
      </div>
      <p id="discovery-count" role="status" aria-live="polite">{records.length} notes · Preparing search…</p>
      <div class="results">{records.map(p => <article data-id={p.id}><time>{p.date}</time><h2><a href={`/blog/${p.id}/`}>{p.title}</a></h2><p>{p.description}</p><div class="article-tags">{p.tags.map(t => <button disabled data-tag={t} aria-pressed="false">{t}</button>)}</div></article>)}</div>
      <p id="discovery-empty" hidden>No notes match. Try another phrase or clear the filters.</p>
    </div>
  </div>
</main>
<style>
  main { max-width: 860px; margin:auto; padding:48px 24px 120px; }
  [hidden] { display:none !important; }
  h1 { font:3.4rem/1.05 var(--font-read); letter-spacing:-.04em; margin:12px 0; }
  .intro { color:var(--muted); max-width:55ch; font:1.15rem/1.6 var(--font-read); }
  .workspace { margin-top:28px; }
  .search-label { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  .discovery-options { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-top:12px; }
  .topics { flex:1; }
  .topics button { font-size:.72rem; padding:4px 8px; border-radius:20px; }
  .text-control { background:transparent; border-color:transparent; color:var(--muted); }
  .advanced { flex-shrink:0; font-size:.75rem; color:var(--muted); }
  summary { cursor:pointer; }
  .advanced[open] { padding-bottom:8px; }
  .active-filters { display:flex; align-items:center; gap:12px; margin-top:10px; font-size:.8rem; color:var(--muted); }
  @media(max-width:700px) { .discovery-options { flex-direction:column; gap:14px; } }
  aside h2 { font-size:.85rem; }
  .topics,.article-tags,.scope { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  button,select,input { font:inherit; color:var(--ink); background:var(--surface); border:1px solid var(--line); border-radius:6px; padding:8px 12px; }
  button { cursor:pointer; } button:hover,button[aria-pressed=true] { border-color:var(--accent); color:var(--accent); background:var(--accent-soft); }
  small { color:var(--muted); margin-left:5px; }
  .search-controls { margin:24px 0 12px; }
  .search-controls > label { display:block; margin-bottom:8px; font-weight:bold; }
  input { box-sizing:border-box; width:100%; padding:15px; font-size:1.1rem; }
  .scope { margin-top:10px; font-size:.85rem; }
  #discovery-count,time { font: .75rem var(--font-mono); color:var(--muted); }
  article { padding:23px 0; border-top:1px solid var(--line); }
  article h2 { font:1.5rem/1.2 var(--font-read); margin:8px 0; } article a { color:var(--ink); text-decoration:none; } article a:hover { color:var(--accent); }
  article p { color:var(--muted); margin:8px 0 14px; }
  .article-tags button { padding:3px 8px; font-size:.75rem; }
  @media(max-width:700px) { h1 { font-size:2.5rem; } }
</style>
<script>
  import { initPostDiscovery } from "../scripts/post-discovery";
  initPostDiscovery();
</script>
