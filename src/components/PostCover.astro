---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt?: string;
}

const { image, alt = "" } = Astro.props;
---

{
  import.meta.env.DEV ? (
    <img
      src={image.src}
      alt={alt}
      width={1600}
      height={900}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  ) : (
    <Image
      src={image}
      alt={alt}
      widths={[800, 1200, 1600]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
  )
}
