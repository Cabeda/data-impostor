---
interface Props {
  variants: { key: string; label: string }[];
}
const { variants } = Astro.props;
---

<div class="proto-bar" role="region" aria-label="Prototype switcher">
  <button class="proto-arrow" data-proto-prev type="button" aria-label="Previous variant">‹</button>
  <span class="proto-tag">PROTOTYPE</span>
  <div class="proto-picks">
    {
      variants.map((variant, index) => (
        <button type="button" data-proto-variant={variant.key} aria-pressed={index === 0 ? "true" : "false"}>
          {variant.key} <b>{variant.label}</b>
        </button>
      ))
    }
  </div>
  <button class="proto-arrow" data-proto-next type="button" aria-label="Next variant">›</button>
</div>

<style>
  .proto-bar {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 7px;
    max-width: calc(100vw - 20px);
    padding: 6px 9px;
    border: 1px dashed #6b7280;
    border-radius: 999px;
    background: #0c0e11;
    color: #f3f0e9;
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.4);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .proto-tag {
    padding: 0 2px;
    color: #f0a868;
    font-size: 9px;
    letter-spacing: 0.12em;
  }
  .proto-picks {
    display: flex;
    gap: 3px;
  }
  .proto-picks button {
    border: 0;
    border-radius: 999px;
    padding: 5px 9px;
    background: transparent;
    color: #b9b4a9;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .proto-picks button b {
    color: #f3f0e9;
    font-weight: 600;
  }
  .proto-picks button[aria-pressed="true"] {
    background: #f3f0e9;
    color: #0c0e11;
  }
  .proto-picks button[aria-pressed="true"] b {
    color: #0c0e11;
  }
  .proto-arrow {
    width: 24px;
    height: 24px;
    border: 1px solid #3a3f47;
    border-radius: 50%;
    background: transparent;
    color: #f3f0e9;
    line-height: 1;
  }
</style>

<script>
  (() => {
    const w = window as unknown as { __diProtoBar?: boolean };
    if (w.__diProtoBar) return;
    w.__diProtoBar = true;

    const keys = Array.from(
      document.querySelectorAll<HTMLElement>("[data-proto-variant]"),
    ).map((button) => button.dataset.protoVariant || "A");

    function current(): string {
      return new URLSearchParams(location.search).get("variant")?.toUpperCase() || keys[0];
    }

    function setVariant(key: string) {
      if (!keys.includes(key)) key = keys[0];
      const url = new URL(location.href);
      url.searchParams.set("variant", key);
      history.replaceState(null, "", url);
      document.documentElement.dataset.protoVariant = key;
      document.querySelectorAll<HTMLElement>("[data-proto-variant]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.protoVariant === key));
      });
    }

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const pick = target.closest<HTMLElement>("[data-proto-variant]");
      if (pick) return setVariant(pick.dataset.protoVariant || keys[0]);
      const index = keys.indexOf(current());
      if (target.closest("[data-proto-prev]")) {
        return setVariant(keys[(index + keys.length - 1) % keys.length]);
      }
      if (target.closest("[data-proto-next]")) {
        return setVariant(keys[(index + 1) % keys.length]);
      }
    });

    document.addEventListener("keydown", (event) => {
      const tag = (event.target as HTMLElement)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
      const index = keys.indexOf(current());
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setVariant(keys[(index + keys.length - 1) % keys.length]);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        setVariant(keys[(index + 1) % keys.length]);
      }
    });

    setVariant(current());
  })();
</script>
