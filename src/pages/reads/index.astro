---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection, render } from "astro:content";
import { ClientRouter } from "astro:transitions";
import ReadingDiary from "../../components/ReadingDiary.astro";
import { groupReadingEntries } from "../../lib/reading-diary";

const allPosts = (await getCollection("reads")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const rendered = await Promise.all(
  allPosts.map(async (post) => {
    const { Content } = await render(post);
    return { id: post.id, data: post.data, body: post.body, Content };
  }),
);

const diary = groupReadingEntries(rendered);
const visibleMonths = diary.months.slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Reading diary · ${SITE_TITLE}`}
      description={`A diary of articles, papers, and books, with the notes I kept. ${diary.noteCount} entries. ${SITE_DESCRIPTION}`}
    />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <ReadingDiary
      months={visibleMonths}
      years={diary.years}
      noteCount={diary.noteCount}
      mode="latest"
    />
    <Footer />
  </body>
</html>
