---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { previewText } from "../lib/mastodon-preview.ts";

const blogposts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestPost = blogposts[0];

const reads = (await getCollection("reads")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestRead = reads[0];
const readHeading = latestRead?.body
  ?.split("\n")
  .find((line) => line.trim().startsWith("#"));
const readTitle = readHeading
  ? readHeading
      .replace(/^#+\s*/, "")
      .replace(/\[([^\]]+)\]\([^)]+\)/, "$1")
      .trim()
  : "Reading notes";

const mastodon = (await getCollection("mastodon")).sort(
  (a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime(),
);
const latestMastodon = mastodon[0];

const contents = [
  latestPost && {
    kind: "Writing",
    href: `/blog/${latestPost.id}/`,
    title: latestPost.data.title,
    date: latestPost.data.pubDate,
  },
  latestRead && {
    kind: "Reading",
    href: "/reads",
    title: readTitle,
    date: latestRead.data.pubDate,
  },
  latestMastodon && {
    kind: "Activity",
    href: `/mastodon/${latestMastodon.id}`,
    title: previewText(latestMastodon.data.content, 64),
    date: new Date(latestMastodon.data.created_at),
  },
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image={latestPost.data.heroImage?.src}
    />
    <ClientRouter />
    <style is:global>
      body.home-page {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
      }
      .home-main {
        flex: 1;
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 28px 32px 18px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
        gap: clamp(36px, 6vw, 88px);
        align-items: center;
      }

      .home-copy h1 {
        margin: 0.12em 0 0;
        font-size: clamp(44px, 5.4vw, 76px);
        line-height: 1;
        letter-spacing: -0.035em;
      }
      .home-copy h1 em {
        display: block;
        margin-top: 0.18em;
        font-size: 0.52em;
        font-weight: 400;
        font-style: italic;
        letter-spacing: -0.015em;
        color: var(--muted);
      }
      .ornament {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
        color: var(--accent);
      }
      .ornament .rule {
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      .ornament .diamond {
        width: 7px;
        height: 7px;
        transform: rotate(45deg);
        background: var(--accent);
      }
      .home-lede {
        max-width: 52ch;
        margin: 0;
        font-family: var(--font-serif);
        font-size: 19px;
        line-height: 1.6;
        color: var(--muted);
      }
      .drop-cap {
        float: left;
        padding: 0.07em 0.11em 0 0;
        font-family: var(--font-serif);
        font-size: 3.15em;
        line-height: 0.82;
        color: var(--accent);
      }
      .home-lede a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid var(--accent-soft);
      }
      .home-ctas {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin: 26px 0 18px;
      }
      .home-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .home-links a {
        color: var(--muted);
        text-decoration: none;
      }
      .home-links a:hover { color: var(--accent); }
      .home-links span { color: var(--line); }
      .home-colophon {
        margin: 22px 0 0;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .home-contents {
        align-self: start;
        border-top: 1px solid var(--line);
        padding-top: 18px;
      }
      .home-contents-list {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
      }
      .home-contents-list li {
        border-bottom: 1px solid var(--line);
      }
      .home-contents-list a {
        display: block;
        padding: 14px 0;
        color: var(--ink);
        text-decoration: none;
      }
      .contents-line {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }
      .contents-num {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--accent);
      }
      .contents-title {
        font-family: var(--font-serif);
        font-size: 18px;
        line-height: 1.25;
        transition: color 140ms ease;
      }
      .home-contents-list a:hover .contents-title { color: var(--accent); }
      .contents-dots {
        flex: 1;
        min-width: 18px;
        margin: 0 2px;
        border-bottom: 1px dotted var(--line);
        transform: translateY(-4px);
      }
      .contents-date {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--muted);
      }
      .contents-kind {
        margin: 5px 0 0 30px;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .contents-note {
        margin: 18px 0 0;
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 15px;
        color: var(--muted);
      }

      @keyframes home-reveal {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
      }
      html[data-book-intro="full"] .home-copy,
      html[data-book-intro="full"] .home-contents {
        animation: home-reveal 700ms cubic-bezier(0.22, 0.8, 0.2, 1) both;
      }
      html[data-book-intro="full"] .home-contents {
        animation-delay: 90ms;
      }

      @media (max-width: 900px) {
        .home-main {
          padding: 22px 22px 14px;
          justify-content: flex-start;
        }
        .home-hero {
          grid-template-columns: minmax(0, 1fr);
          gap: 26px;
        }
        .home-copy h1 {
          font-size: 44px;
        }
        .home-copy h1 em {
          font-size: 0.56em;
        }
        .home-lede {
          font-size: 16px;
          line-height: 1.55;
        }
        .drop-cap {
          font-size: 2.8em;
        }
        .home-ctas {
          margin: 18px 0 12px;
        }
        .home-colophon {
          margin-top: 16px;
        }
        .home-contents {
          padding-top: 14px;
        }
        .contents-title {
          font-size: 16px;
        }
        .contents-kind {
          margin-left: 26px;
        }
      }
      @media (max-width: 820px) and (max-height: 720px) {
        .home-main { padding: 12px 18px; }
        .home-hero { gap: 16px; }
        .home-copy h1 { font-size: 36px; }
        .home-lede { font-size: 14.5px; line-height: 1.5; }
        .drop-cap { font-size: 2.4em; }
        .home-ctas { margin: 12px 0 8px; }
        .home-links { font-size: 9px; }
        .home-colophon { margin-top: 12px; }
        .home-contents-list a { padding: 10px 0; }
        .contents-title { font-size: 15px; }
        .contents-kind { display: none; }
      }
    </style>
  </head>

  <body class="home-page">
    <Header />
    <main class="home-main">
      <section class="home-hero" aria-labelledby="home-title">
        <div class="home-copy">
          <p class="kicker">Data engineer · Portugal</p>
          <h1 id="home-title">
            I'm Cabeda.<br /><em>Just another curious data engineer.</em>
          </h1>
          <div class="ornament" aria-hidden="true">
            <span class="rule"></span>
            <span class="diamond"></span>
            <span class="rule"></span>
          </div>
          <p class="home-lede">
            <span class="drop-cap" aria-hidden="true">N</span><span class="sr-only">N</span>otes on
            data systems, the tools I build, the books I read, and the life in
            between. This is my notebook, kept in public.{" "}
            <a href="/about">More about me →</a>
          </p>
          <div class="home-ctas">
            <a class="btn btn-primary" href={`/blog/${latestPost.id}/`}>
              Start reading <span aria-hidden="true">→</span>
            </a>
            <a class="btn" href="/about">About me</a>
            <a class="btn btn-quiet" href="/mastodon">See activity</a>
          </div>
          <nav class="home-links" aria-label="Sections">
            <a href="/blog">Notebook</a>
            <span>·</span>
            <a href="/reads">Reading</a>
            <span>·</span>
            <a href="/projects">Projects</a>
            <span>·</span>
            <a href="/talks">Talks</a>
            <span>·</span>
            <a href="/rss.xml">RSS</a>
          </nav>
          <p class="home-colophon">Written in Lisbon · Since 2019</p>
        </div>

        <aside class="home-contents" aria-label="Recently">
          <p class="kicker">Contents</p>
          <ol class="home-contents-list">
            {
              contents.map((item, index) => (
                <li>
                  <a href={item.href}>
                    <div class="contents-line">
                      <span class="contents-num">{String(index + 1).padStart(2, "0")}</span>
                      <span class="contents-title">{item.title}</span>
                      <span class="contents-dots" aria-hidden="true"></span>
                      <span class="contents-date">
                        <FormattedDate date={item.date} />
                      </span>
                    </div>
                    <p class="contents-kind">{item.kind}</p>
                  </a>
                </li>
              ))
            }
          </ol>
          <p class="contents-note">No feed, no algorithm, no rush.</p>
        </aside>
      </section>
    </main>
  </body>
</html>
