---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { latestContents } from "../lib/home-shelf.ts";

const blogposts = await getCollection("blog");
const reads = await getCollection("reads");
const mastodon = await getCollection("mastodon");

const latestPost = [...blogposts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)[0];
const startHref = "/blog";
const contents = latestContents(blogposts, reads, mastodon);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image={latestPost?.data.heroImage?.src}
    />
    <ClientRouter />
    <style is:global>
      @font-face {
        font-family: "Diary Ink";
        src: url("/fonts/la-belle-aurore.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      body.home-page {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
      }
      .home-main {
        flex: 1;
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 28px 32px 18px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
        gap: clamp(36px, 6vw, 88px);
        align-items: center;
      }

      .home-copy {
        font-size: var(--read-size);
        overflow: visible;
      }
      .home-title {
        margin: 0.08em 0 0.12em;
        padding-top: 0.06em;
        font-family: "Diary Ink", var(--font-serif);
        font-size: clamp(54px, 6.4vw, 92px);
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--ink);
        text-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
        overflow: visible;
      }
      .home-title .ink {
        display: inline-block;
        white-space: nowrap;
        overflow: visible;
        clip-path: inset(0 100% 0 0);
        animation: ink-write 1900ms cubic-bezier(0.45, 0.05, 0.2, 1) forwards;
      }
      .home-title .ink::after {
        content: "";
        display: inline-block;
        width: 2px;
        height: 0.72em;
        margin-left: 0.05em;
        vertical-align: -0.04em;
        background: var(--accent);
        animation: ink-blink 1.1s steps(1) infinite;
      }
      @keyframes ink-write {
        to { clip-path: inset(0 0 0 0); }
      }
      @keyframes ink-blink {
        0%, 55% { opacity: 1; }
        56%, 100% { opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .home-title .ink { clip-path: none; animation: none; }
        .home-title .ink::after { display: none; }
      }
      .ornament {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
        color: var(--accent);
      }
      .ornament .rule {
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      .ornament .diamond {
        width: 7px;
        height: 7px;
        transform: rotate(45deg);
        background: var(--accent);
      }
      .home-lede {
        max-width: 42ch;
        margin: 0;
        font-family: var(--font-read);
        font-size: 1.08em;
        line-height: 1.5;
        color: var(--muted);
      }
      .home-lede a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid var(--accent-soft);
      }
      .home-ctas {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin: 22px 0 0;
      }

      .home-contents {
        align-self: start;
        border-top: 1px solid var(--line);
        padding-top: 18px;
        font-size: var(--read-size);
      }
      .home-contents-list {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
      }
      .home-contents-list li {
        border-bottom: 1px solid var(--line);
      }
      .home-contents-list a {
        display: block;
        padding: 14px 0;
        color: var(--ink);
        text-decoration: none;
      }
      .contents-line {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }
      .contents-num {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--accent);
      }
      .contents-title {
        font-family: var(--font-read);
        font-size: 0.95em;
        line-height: 1.25;
        transition: color 140ms ease;
      }
      .home-contents-list a:hover .contents-title { color: var(--accent); }
      .contents-dots {
        flex: 1;
        min-width: 18px;
        margin: 0 2px;
        border-bottom: 1px dotted var(--line);
        transform: translateY(-4px);
      }
      .contents-date {
        flex: 0 0 auto;
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--muted);
      }
      .contents-kind {
        margin: 5px 0 0 30px;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
      }
      @keyframes home-reveal {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
      }
      html[data-book-intro="full"] .home-copy,
      html[data-book-intro="full"] .home-contents {
        animation: home-reveal 700ms cubic-bezier(0.22, 0.8, 0.2, 1) both;
      }
      html[data-book-intro="full"] .home-contents {
        animation-delay: 90ms;
      }

      @media (max-width: 900px) {
        .home-main {
          padding: 22px 22px 14px;
          justify-content: flex-start;
        }
        .home-hero {
          grid-template-columns: minmax(0, 1fr);
          gap: 26px;
        }
        .home-title {
          font-size: clamp(46px, 13vw, 62px);
        }
        .home-lede {
          font-size: 1em;
          line-height: 1.5;
        }
        .home-ctas {
          margin: 16px 0 0;
        }
        .home-contents {
          padding-top: 14px;
        }
        .contents-title {
          font-size: 0.85em;
        }
        .contents-kind {
          margin-left: 26px;
        }
      }
      @media (max-width: 820px) and (max-height: 720px) {
        .home-main { padding: 12px 18px; }
        .home-hero { gap: 16px; }
        .home-title { font-size: 42px; }
        .home-lede { font-size: 0.95em; line-height: 1.45; }
        .home-ctas { margin: 12px 0 0; }
        .home-contents-list a { padding: 10px 0; }
        .contents-title { font-size: 0.8em; }
        .contents-kind { display: none; }
      }
    </style>
  </head>

  <body class="home-page">
    <Header />
    <main class="home-main">
      <section class="home-hero" aria-labelledby="home-title">
        <div class="home-copy">
          <h1 id="home-title" class="home-title">
            <span class="ink">José Cabeda</span>
          </h1>
          <div class="ornament" aria-hidden="true">
            <span class="rule"></span>
            <span class="diamond"></span>
            <span class="rule"></span>
          </div>
          <p class="home-lede">
            A nerd, reader and fan of francesinhas. Oh, and data engineer.
          </p>
          <div class="home-ctas">
            <a class="btn btn-primary" href={startHref}>
              Start reading <span aria-hidden="true">→</span>
            </a>
            <a class="btn btn-quiet" href="/about">About me</a>
          </div>
        </div>

        <aside class="home-contents" aria-label="Recently">
          <p class="kicker">Contents</p>
          <ol class="home-contents-list">
            {
              contents.map((item, index) => (
                <li>
                  <a href={item.href}>
                    <div class="contents-line">
                      <span class="contents-num">{String(index + 1).padStart(2, "0")}</span>
                      <span class="contents-title">{item.title}</span>
                      <span class="contents-dots" aria-hidden="true"></span>
                      <span class="contents-date">
                        <FormattedDate date={item.date} />
                      </span>
                    </div>
                    <p class="contents-kind">{item.kind}</p>
                  </a>
                </li>
              ))
            }
          </ol>
        </aside>
      </section>
    </main>
  </body>
</html>
