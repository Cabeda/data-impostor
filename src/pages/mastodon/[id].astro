---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MastodonComments from '../../components/MastodonComments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('mastodon');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`Post by ${post.data.account.display_name}`} description={post.data.content.replace(/<[^>]*>/g, '').substring(0, 160)} />
    <link rel="preconnect" href="https://mastodon.social" crossorigin />
    <link rel="dns-prefetch" href="https://mastodon.social" />
  </head>
  <body>
    <Header />
    <main class="mastodon-main">
      <article class="post">
        <div class="post-header">
          <img
            src={post.data.account.avatar}
            alt={post.data.account.display_name}
            class="avatar"
            width="48"
            height="48"
            loading="eager"
          />
          <div class="post-meta">
            <div class="post-author">
              <strong>{post.data.account.display_name}</strong>
              <span class="username">@{post.data.account.username}</span>
            </div>
            <time datetime={post.data.created_at} class="post-time">
              {new Date(post.data.created_at).toLocaleString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: 'numeric',
                minute: '2-digit',
              })}
            </time>
          </div>
        </div>

        {post.data.spoiler_text && (
          <details class="content-warning">
            <summary>Content warning: {post.data.spoiler_text}</summary>
            <div class="post-content" set:html={post.data.content} />
          </details>
        )}
        {!post.data.spoiler_text && (
          <div class="post-content" set:html={post.data.content} />
        )}

        {post.data.images && post.data.images.length > 0 && (
          <div class="post-media">
            {post.data.images.map((img: { url: string; description?: string }) => (
              <img
                src={img.url}
                alt={img.description || ''}
                loading="lazy"
                width="400"
                height="300"
              />
            ))}
          </div>
        )}

        <div class="post-footer">
          <a href={post.data.url} target="_blank" rel="noopener" class="view-original">
            View on Mastodon →
          </a>
        </div>
      </article>

      <MastodonComments mastodonUrl={post.data.url} buildTime={new Date()} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .mastodon-main {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .post {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .post-header {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .post-author {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .post-author strong {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .username {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .post-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .post-content {
    font-family: var(--font-read);
    font-size: var(--read-size);
    line-height: var(--read-leading);
    color: var(--ink);
  }

  .post-content p {
    margin: 0 0 0.75em;
  }

  .post-content a {
    color: var(--accent);
    text-decoration: none;
  }

  .post-content a:hover {
    text-decoration: underline;
  }

  .post-content img {
    max-width: 100%;
    border-radius: 8px;
  }

  .post-media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.5rem;
    margin: 0.75rem 0;
  }

  .post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    aspect-ratio: 4 / 3;
  }

  .content-warning {
    margin: 0.75rem 0;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-2);
  }

  .content-warning summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
  }

  .post-footer {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .view-original {
    margin: 0;
  }

  .view-original a {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .view-original a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .mastodon-main {
      padding: 2rem 1rem;
    }
    .post-media {
      grid-template-columns: 1fr;
    }
  }
</style>
