{
  "name": "data-impostor",
  "type": "module",
  "version": "1.0.0",
  "author": {
    "name": "José Cabeda",
    "email": "jecabeda@gmail.com"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:timings": "astro build --timings",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test \"src/lib/**/*.test.ts\"",
    "test:reader": "node --test tests/reader-*.test.mjs",
    "check": "astro check",
    "new-article": "deno run --allow-read --allow-write --allow-run scripts/new_article.ts",
    "syndicate": "deno run --allow-read --allow-write --allow-env --allow-net scripts/syndicate.ts",
    "spellcheck": "bash scripts/spellcheck.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@slidev/theme-default": "^0.25.0",
    "astro": "^7.4.4",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5",
    "slidev-theme-academic": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright-chromium": "^1.53.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.0"
  }
}
